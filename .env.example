# Fast Sub local environment example.
# Copy this file to .env for local use. Do not commit real secrets.

# Required for api-openai-chat translation.
OPENAI_API_KEY=sk-your-api-key-here

# Required for api-openai-chat translation unless --model is passed.
# For LM Studio this must match the loaded model id shown by /v1/models.
OPENAI_MODEL=qwen3-4b

# Optional: override for OpenAI-compatible APIs.
OPENAI_BASE_URL=https://api.openai.com/v1
