{
  "name": "fast-sub-desktop",
  "version": "0.13.1",
  "description": "Fast Sub local-first desktop subtitle workbench",
  "author": "Fast Sub",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev-clean.mjs",
    "dev:dirty": "electron-vite dev",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:round12": "node scripts/round12-check.mjs",
    "build": "electron-vite build",
    "smoke": "node test/smoke.mjs",
    "smoke:packaged": "node scripts/smoke-packaged-runtime.mjs",
    "smoke:translation-model-failure": "node scripts/smoke-translation-model-failure.mjs",
    "smoke:web-translation": "node scripts/smoke-web-translation.mjs",
    "smoke:native-deps": "node scripts/smoke-native-dependencies.mjs",
    "prepare:python-runtime": "node scripts/prepare-python-runtime.mjs",
    "prepare:web-translate-helper": "node scripts/prepare-web-translate-helper.mjs",
    "prepare:whisper-cpp-runtime": "node scripts/prepare-whisper-cpp-runtime.mjs",
    "prepare:release-resources": "npm run prepare:web-translate-helper && node scripts/prepare-release-resources.mjs",
    "clean:release": "node scripts/clean-release-output.mjs",
    "package:dir": "npm run clean:release && npm run build && npm run prepare:whisper-cpp-runtime && npm run prepare:release-resources && electron-builder --dir",
    "package": "npm run clean:release && npm run build && npm run prepare:whisper-cpp-runtime && npm run prepare:release-resources && electron-builder"
  },
  "dependencies": {
    "@vitalets/google-translate-api": "9.2.1",
    "bing-translate-api": "4.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@swc/core": "^1.15.33",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^4.0.14",
    "electron": "^39.2.7",
    "electron-builder": "^26.8.1",
    "electron-vite": "^4.0.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  },
  "build": {
    "afterPack": "scripts/after-pack-web-translate-helper.cjs",
    "appId": "app.fastsub.desktop",
    "productName": "Fast Sub",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "asar": true,
    "compression": "store",
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/python",
        "to": "python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/web-translate-helper",
        "to": "web-translate-helper",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "../THIRD_PARTY_NOTICES.md",
        "to": "THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FastSub-Desktop-${version}-windows-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "FastSub-Desktop-${version}-macos-${arch}.${ext}"
    }
  }
}
